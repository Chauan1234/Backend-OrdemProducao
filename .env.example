# Configurações locais de desenvolvimento. Copie para .env e ajuste conforme necessário.
# O Docker Compose lê .env automaticamente; o Maven precisa receber essas variáveis
# pelo terminal ao executar os testes.

POSTGRES_DB=ordem_producao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ordem_producao
DB_USER=postgres
DB_PASSWORD=postgres

SERVER_PORT=8080
